# 网页和翻译服务（Node.js 22+）
HOST=0.0.0.0
PORT=8788
TRANSLATION_CACHE_DIR=/data/translations
# 动态缓存默认保存在 TRANSLATION_CACHE_DIR/feed，可用 FEED_CACHE_DIR 指定独立目录。

# X 原文截图选填：Cloudflare Browser Rendering REST API 凭据与持久化缓存目录。
X_SCREENSHOT_CACHE_DIR=/data/x-screenshots
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_API_TOKEN=

# AI 翻译选填：完整的 Chat Completions URL，配置后重启服务生效。
AI_TRANSLATION_URL=
AI_TRANSLATION_MODEL=
AI_TRANSLATION_API_KEY=
